# vllm/.env 샘플 — 서버에서 `cp .env.example .env` 후 값을 채워 사용 (.env는 git 추적 금지)

# ── 모델 (필수) ──────────────────────────────────────────────────────────
MODEL_ID=QuantTrio/Qwen3.5-9B-AWQ

# LiteLLM에 노출될 모델 이름 — litellm/config.yaml 새 엔트리의 hosted_vllm/<이 값>과 일치해야 함
SERVED_NAME=vllm-srv

# ── 컨테이너 이름 ────────────────────────────────────────────────────────
# docker ps에서 어떤 모델을 서빙 중인지 바로 보이도록 모델명을 쓴다.
# ⚠️ SERVED_NAME(LiteLLM 노출명)과 별개다 — 이 값을 바꿔도 게이트웨이는 영향 없음.
# ⚠️ 이 값을 바꾸면 기존 컨테이너가 고아로 남는다 → docker compose up -d --remove-orphans
CONTAINER_NAME=vllm-main   # 예: vllm-qwen3-8b — 실제 MODEL_ID에 맞춰 수정할 것

# ── 이미지 ──────────────────────────────────────────────────────────────
# 서버에서 선행 1회: docker tag vllm/vllm-openai:nightly vllm-openai:gb10-verified
VLLM_IMAGE=vllm-openai:gb10-verified

# ── 메모리 ──────────────────────────────────────────────────────────────
# 통합 메모리를 두 스택이 공유. 기존 단일 구성은 gpu-memory-utilization 0.7 사용
# → 동시 기동 시 합산이 0.9를 넘지 않도록 조정
GPU_MEM_UTIL=0.25
MEM_LIMIT=40gb

# ── 서빙 파라미터 ────────────────────────────────────────────────────────
# MAX_MODEL_LEN: 요청당 최대 컨텍스트(토큰). KV 캐시 메모리와 직결 — 길수록 동시 처리 수 감소
MAX_MODEL_LEN=8192
# MAX_NUM_SEQS: 한 배치에 동시에 태울 최대 요청 수 (vLLM continuous batching)
MAX_NUM_SEQS=8

# ── 추가 옵션 (선택) — 공백 구분으로 vllm serve 플래그를 이어붙임 ──────────────
# 자주 쓰는 예:
#   --kv-cache-dtype fp8          KV 캐시 절반 압축 → 동시 처리 수 ~2배 (Blackwell 지원)
#   --reasoning-parser qwen3      Qwen3.5 thinking 모드 출력 파싱 (LiteLLM 연동 시 확인)
#   --max-num-batched-tokens 4096 prefill 배치 상한 (응답 첫 토큰 지연 vs 처리량 트레이드오프)
#   --no-enable-prefix-caching    프리픽스 캐싱 끄기 (기본 on — 시스템 프롬프트 공유 시 이득이라 보통 유지)
# 예: EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser qwen3
EXTRA_ARGS=

# ── 리랭커 (별도 컨테이너 vllm-rerank, 호스트 포트 53109) ──────────────────────
# vLLM은 1 프로세스 = 1 모델. 리랭커는 본체와 별개 프로세스로 뜬다.
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
# litellm/config.yaml의 hosted_vllm/<이 값>과 일치해야 함
RERANK_SERVED_NAME=bge-reranker-v2-m3
RERANK_CONTAINER_NAME=vllm-bge-reranker-v2-m3
# 리랭커는 KV 캐시가 없는 pooling 모델(568M)이라 예산을 "채우지" 않는다.
# vLLM은 Attention 모듈에서 KV spec을 만드는데 XLMRoberta 인코더는 해당 레이어가 없어
# 빈 spec이 나온다 → 가중치(~1.1GB)만 쓴다. 실측 1,483MiB.
# 0.03 = 121Gi × 0.03 ≈ 3.6Gi — 실측의 2배 여유. 0.02 미만은 기동 시 프로파일링이 실패할 수 있다.
# ⚠️ 본체(GPU_MEM_UTIL) + 이 값 + MUSE_GPU_MEM_UTIL의 합이 MEM_BUDGET_CEILING을 넘지 않도록 할 것
RERANK_GPU_MEM_UTIL=0.03
RERANK_MEM_LIMIT=8gb
RERANK_MAX_MODEL_LEN=8192
RERANK_MAX_NUM_SEQS=32
# pooling 러너 자동 인식이 실패할 때만: RERANK_EXTRA_ARGS=--runner pooling
RERANK_EXTRA_ARGS=

# ══ Muse-Glimmer-30B (별도 컨테이너 vllm-muse, 호스트 포트 53107) ══════════════
# ⚠️ compose profile "muse"로 격리돼 있어 `docker compose up -d`로는 뜨지 않는다.
#    기동: docker compose --profile muse up -d
#    compose 안의 muse-preflight 서비스가 먼저 돌면서 아래 (1)(2)와 실측 여유를
#    검사하고, 실패하면 vllm-muse는 시작되지 않는다. 별도 셸 스크립트는 없다.
#
# ── 기동 전 필수 확인 2가지 ──────────────────────────────────────────────
# (1) 이미지 지원: vLLM의 muse_glimmer 지원은 2026-08-14에 main에 들어갔다.
#     정식 릴리스 v0.27.1(2026-08-11)에는 없다 → gb10-verified 태그가 그 이전
#     nightly면 "Unrecognized architecture"로 죽는다. muse-preflight가 먼저 검사한다.
#     지원이 없으면 nightly를 다시 받아 **새 태그**로 검증할 것 (기존 태그는 보존):
#       docker pull vllm/vllm-openai:nightly
#       docker tag vllm/vllm-openai:nightly vllm-openai:gb10-verified-2
#       # 검증 통과 후 VLLM_IMAGE=vllm-openai:gb10-verified-2
#
# (2) 메모리 예산: vLLM의 --gpu-memory-utilization은 각 프로세스가 **전체 통합
#     메모리 기준**으로 독립 계산한다. 서로 조율하지 않으므로 합을 직접 관리해야 한다.
#
#     ⚠️ GB10은 CPU와 GPU가 같은 메모리를 쓴다. 합이 1.0에 가까워지면 남는 게
#     없어서 OS가 죽는다(OOM killer). 데스크톱(Xorg/gnome-shell)까지 떠 있으므로
#     여유를 넉넉히 남긴다 → 상한 MEM_BUDGET_CEILING=0.80 (121Gi 중 약 24Gi 여유).
#
#       NEIGHBOR_GPU_MEM_UTIL  (외부 스택 — 현재 철거돼 0)
#     + GPU_MEM_UTIL           (본체 vllm)
#     + RERANK_GPU_MEM_UTIL    (리랭커)
#     + MUSE_GPU_MEM_UTIL      (이 서비스)
#     ────────────────────────────────────────
#     ≤ MEM_BUDGET_CEILING  ← muse-preflight가 검사하고, 넘으면 기동을 거부한다
#
#     현재 구성: 0 + 0.25 + 0.03 + 0.22 = 0.50 ✅ (약 61Gi, 여유 60Gi)
#
#     주의: 이 합계는 보수적이다. 생성 모델(본체·Muse)은 KV 캐시로 예산을 채우지만
#     리랭커(pooling)는 안 채운다 — 장부상 0.03이어도 실제로는 ~1.5Gi다.
#
#     muse-preflight는 이 설정값 합계와 **별개로 /proc/meminfo 실측 여유**도 검사한다.
#     설정값은 "이론상 안전한가", 실측은 "지금 실제로 뜰 수 있나"를 본다.

# 외부 vLLM 스택(구 :53107)의 gpu-memory-utilization.
# 2026-08 철거됨 → 0. 다시 올라오면 그쪽 실제 값을 여기 적을 것.
NEIGHBOR_GPU_MEM_UTIL=0

# 네 값의 합에 대한 상한. 통합 메모리라 1.0에 가까우면 OS가 죽는다.
# 데스크톱을 끄고 여유를 더 쓰고 싶으면 0.85까지가 현실적인 한계.
MEM_BUDGET_CEILING=0.80

# 실측 검사용 안전 여유(GiB). muse-preflight는 "MemAvailable ≥ Muse 필요량 + 이 값"
# 일 때만 통과시킨다. OS·페이지캐시·모델 로딩 중 일시 스파이크를 흡수하는 몫이다.
MEM_SAFETY_MARGIN_GB=8
# ── 모델 ────────────────────────────────────────────────────────────────
# bf16 원본(meta-models/Muse-Glimmer-30B)은 가중치만 59.5GB → 이 서버에 못 올린다.
# 기본값은 NVFP4 양자화본(20GB, compressed-tensors / nvfp4-pack-quantized).
# GB10은 Blackwell(sm_121)이라 NVFP4 네이티브 경로 대상.
# NVFP4 커널 문제 시 폴백: RedHatAI/Muse-Glimmer-30B-INT4 (W4A16, 19.5GB)
MUSE_MODEL_ID=RedHatAI/Muse-Glimmer-30B-NVFP4
# litellm/config.yaml의 hosted_vllm/<이 값>과 일치해야 함
MUSE_SERVED_NAME=muse-glimmer-30b
MUSE_CONTAINER_NAME=vllm-muse-glimmer-30b

# ── 메모리 ──────────────────────────────────────────────────────────────
# 0.22 = 121Gi × 0.22 ≈ 26.6Gi 를 이 프로세스의 상한으로 잡는다.
#   내역: 가중치 18.6Gi(NVFP4 20GB) + 활성값·비전 인코더 ~2Gi + 나머지가 KV 캐시(~6Gi)
#   KV는 실제로 훨씬 적게 든다 — 52층 중 39층이 sliding window 2048이고 full attention은
#   13층뿐이라 8192 컨텍스트 × 4 동시 요청이 1Gi 미만이다. 즉 0.22는 여유 있는 값.
# 하한은 0.18 근처(≈21.8Gi) — 가중치+활성값을 겨우 덮는 수준이라 KV가 거의 안 남는다.
# 올려도 이득이 적다: KV가 병목이 아니라서 0.30으로 늘려도 동시 처리 수는 별로 안 는다.
# → 0.22로 시작하고, 기동 후 로그의 KV 실측치를 보고 조정할 것
# (docker logs vllm-muse-glimmer-30b | grep -E "Available KV cache|Maximum concurrency")
MUSE_GPU_MEM_UTIL=0.22
# 컨테이너(cgroup) 하드 캡. vLLM 예산(26.6Gi)보다 넉넉해야 cgroup OOM-kill을 안 당한다
MUSE_MEM_LIMIT=32gb
# 재시작 정책. 기본 "no" — 본체·리랭커(unless-stopped)와 다르다.
# unless-stopped면 재부팅 후 도커 데몬이 muse-preflight를 건너뛰고 되살린다.
# 그 사이 .env 배분이 바뀌었으면 부팅 직후 OOM이 난다. 재부팅 후에는
# `docker compose --profile muse up -d`로 검사를 다시 거쳐 올릴 것.
MUSE_RESTART=no
# ── 서빙 파라미터 ────────────────────────────────────────────────────────
# 원본 컨텍스트는 131072지만 KV 예산상 8192로 자른다.
MUSE_MAX_MODEL_LEN=8192
# 30B라 본체(8)보다 보수적으로. KV 실측 후 상향 가능
MUSE_MAX_NUM_SEQS=4
# 프롬프트당 허용 이미지 수. 0 = 텍스트 전용(비전 경로 메모리 프로파일링 생략).
# 이미지 입력을 쓰려면 2 등으로 올리고 MUSE_GPU_MEM_UTIL도 함께 올릴 것
MUSE_MAX_IMAGES=0

# ── 추가 옵션 (선택) ─────────────────────────────────────────────────────
# 자주 쓰는 예:
#   --kv-cache-dtype fp8   KV 절반 압축 (Blackwell 지원)
# 투기적 디코딩(선택, 안정화 후): 드래프트 헤드 meta-models/Muse-Glimmer-30B-assistant를
#   vLLM이 qwen3_dflash로 매핑해 둠 → --speculative-config 로 연결. 메모리 추가 소요 주의
MUSE_EXTRA_ARGS=
