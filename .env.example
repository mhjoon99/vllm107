# vllm/.env 샘플 — 서버에서 `cp .env.example .env` 후 값을 채워 사용 (.env는 git 추적 금지)

# ── 모델 (필수) ──────────────────────────────────────────────────────────
MODEL_ID=

# LiteLLM에 노출될 모델 이름 — litellm/config.yaml 새 엔트리의 hosted_vllm/<이 값>과 일치해야 함
SERVED_NAME=vllm-srv

# ── 이미지 ──────────────────────────────────────────────────────────────
# 서버에서 선행 1회: docker tag vllm/vllm-openai:nightly vllm-openai:gb10-verified
VLLM_IMAGE=vllm-openai:gb10-verified

# ── 메모리 ──────────────────────────────────────────────────────────────
# 통합 메모리를 두 스택이 공유. 기존 단일 구성은 gpu-memory-utilization 0.7 사용
# → 동시 기동 시 합산이 0.9를 넘지 않도록 조정
GPU_MEM_UTIL=0.25
MEM_LIMIT=40gb

# ── 서빙 파라미터 ────────────────────────────────────────────────────────
# MAX_MODEL_LEN: 요청당 최대 컨텍스트(토큰). KV 캐시 메모리와 직결 — 길수록 동시 처리 수 감소
MAX_MODEL_LEN=8192
# MAX_NUM_SEQS: 한 배치에 동시에 태울 최대 요청 수 (vLLM continuous batching)
MAX_NUM_SEQS=8

# ── 추가 옵션 (선택) — 공백 구분으로 vllm serve 플래그를 이어붙임 ──────────────
# 자주 쓰는 예:
#   --kv-cache-dtype fp8          KV 캐시 절반 압축 → 동시 처리 수 ~2배 (Blackwell 지원)
#   --reasoning-parser qwen3      Qwen3.5 thinking 모드 출력 파싱 (LiteLLM 연동 시 확인)
#   --max-num-batched-tokens 4096 prefill 배치 상한 (응답 첫 토큰 지연 vs 처리량 트레이드오프)
#   --no-enable-prefix-caching    프리픽스 캐싱 끄기 (기본 on — 시스템 프롬프트 공유 시 이득이라 보통 유지)
# 예: EXTRA_ARGS=--kv-cache-dtype fp8 --reasoning-parser qwen3
EXTRA_ARGS=

# ── 리랭커 (별도 컨테이너 vllm-rerank, 호스트 포트 53109) ──────────────────────
# vLLM은 1 프로세스 = 1 모델. 리랭커는 본체와 별개 프로세스로 뜬다.
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
# litellm/config.yaml의 hosted_vllm/<이 값>과 일치해야 함
RERANK_SERVED_NAME=bge-reranker-v2-m3
# 리랭커는 KV 캐시가 없는 pooling 모델(568M) — 아주 작게 잡아도 충분
# ⚠️ 옆 스택(:53107, 0.7) + 본체(GPU_MEM_UTIL) + 이 값의 합이 0.9를 넘지 않도록 조정할 것
RERANK_GPU_MEM_UTIL=0.05
RERANK_MEM_LIMIT=8gb
RERANK_MAX_MODEL_LEN=8192
RERANK_MAX_NUM_SEQS=32
# pooling 러너 자동 인식이 실패할 때만: RERANK_EXTRA_ARGS=--runner pooling
RERANK_EXTRA_ARGS=

# ══ Muse-Glimmer-30B (별도 컨테이너 vllm-muse, 호스트 포트 53110) ══════════════
# ⚠️ compose profile "muse"로 격리돼 있어 `docker compose up -d`로는 뜨지 않는다.
#    기동: bash scripts/up_muse.sh  (메모리 예산 + 이미지 아키텍처 지원 선검사 포함)
#
# ── 기동 전 필수 확인 2가지 ──────────────────────────────────────────────
# (1) 이미지 지원: vLLM의 muse_glimmer 지원은 2026-08-14에 main에 들어갔다.
#     정식 릴리스 v0.27.1(2026-08-11)에는 없다 → gb10-verified 태그가 그 이전
#     nightly면 "Unrecognized architecture"로 죽는다. up_muse.sh가 먼저 검사한다.
#     지원이 없으면 nightly를 다시 받아 **새 태그**로 검증할 것 (기존 태그는 보존):
#       docker pull vllm/vllm-openai:nightly
#       docker tag vllm/vllm-openai:nightly vllm-openai:gb10-verified-2
#       # 검증 통과 후 VLLM_IMAGE=vllm-openai:gb10-verified-2
#
# (2) 메모리 예산: vLLM의 --gpu-memory-utilization은 각 프로세스가 **전체 통합
#     메모리 기준**으로 독립 계산한다. 즉 아래 4개의 합이 1.0을 넘으면 OOM이다.
#     현재 배분만으로 이미 0.7 + 0.25 + 0.05 = 1.00 → **30B가 들어갈 자리가 없다.**
#     옆 스택이 얼마를 반납할지 협의해서 아래 두 값을 맞춰야 켤 수 있다.
#
#       NEIGHBOR_GPU_MEM_UTIL  (옆 스택, 우리가 못 바꿈 — 협의 결과를 여기 기록)
#     + GPU_MEM_UTIL           (본체 vllm)
#     + RERANK_GPU_MEM_UTIL    (리랭커)
#     + MUSE_GPU_MEM_UTIL      (이 서비스)
#     ────────────────────────────────────────
#     ≤ 0.90  ← up_muse.sh가 이 합을 검사하고, 넘으면 기동을 거부한다
#
#     예) 옆 스택이 0.7 → 0.40으로 낮춰주면: 0.40 + 0.25 + 0.05 + 0.22 = 0.92 (아직 초과)
#         옆 0.40 + 본체 0.15 + 리랭커 0.05 + Muse 0.22 = 0.82 ✅
#
# 옆 스택의 현재 gpu-memory-utilization 값 (예산 검사용 — 협의 후 실제 값으로 갱신)
NEIGHBOR_GPU_MEM_UTIL=0.7

# ── 모델 ────────────────────────────────────────────────────────────────
# bf16 원본(meta-models/Muse-Glimmer-30B)은 가중치만 59.5GB → 이 서버에 못 올린다.
# 기본값은 NVFP4 양자화본(20GB, compressed-tensors / nvfp4-pack-quantized).
# GB10은 Blackwell(sm_121)이라 NVFP4 네이티브 경로 대상.
# NVFP4 커널 문제 시 폴백: RedHatAI/Muse-Glimmer-30B-INT4 (W4A16, 19.5GB)
MUSE_MODEL_ID=RedHatAI/Muse-Glimmer-30B-NVFP4
# litellm/config.yaml의 hosted_vllm/<이 값>과 일치해야 함
MUSE_SERVED_NAME=muse-glimmer-30b

# ── 메모리 ──────────────────────────────────────────────────────────────
# 가중치 20GB + KV + 비전 인코더/활성값 → 실측 전 추정 24~26GB.
# 128GB 기준 0.22 ≈ 28GB. 첫 기동 후 up_muse.sh가 출력하는 KV 캐시 실측치로 조정할 것.
MUSE_GPU_MEM_UTIL=0.22
MUSE_MEM_LIMIT=32gb

# ── 서빙 파라미터 ────────────────────────────────────────────────────────
# 원본 컨텍스트는 131072지만 KV 예산상 8192로 자른다.
MUSE_MAX_MODEL_LEN=8192
# 30B라 본체(8)보다 보수적으로. KV 실측 후 상향 가능
MUSE_MAX_NUM_SEQS=4
# 프롬프트당 허용 이미지 수. 0 = 텍스트 전용(비전 경로 메모리 프로파일링 생략).
# 이미지 입력을 쓰려면 2 등으로 올리고 MUSE_GPU_MEM_UTIL도 함께 올릴 것
MUSE_MAX_IMAGES=0

# ── 추가 옵션 (선택) ─────────────────────────────────────────────────────
# 자주 쓰는 예:
#   --kv-cache-dtype fp8   KV 절반 압축 (Blackwell 지원)
# 투기적 디코딩(선택, 안정화 후): 드래프트 헤드 meta-models/Muse-Glimmer-30B-assistant를
#   vLLM이 qwen3_dflash로 매핑해 둠 → --speculative-config 로 연결. 메모리 추가 소요 주의
MUSE_EXTRA_ARGS=
